{
    "name": "vampire-survivors-enhanced",
    "version": "1.0.0",
    "description": "Enhanced Vampire Survivors browser game with performance optimizations and advanced features",
    "type": "module",
    "scripts": {
        "test": "NODE_OPTIONS=--experimental-vm-modules jest",
        "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
        "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
        "lint": "eslint src/ --ext .js",
        "lint:fix": "eslint src/ --ext .js --fix",
        "format": "prettier --write 'src/**/*.js'",
        "format:check": "prettier --check 'src/**/*.js'",
        "serve": "python3 -m http.server 8000",
        "dev": "python3 -m http.server 8000",
        "check": "npm run lint && npm run format:check && npm run test"
    },
    "jest": {
        "testEnvironment": "jsdom",
        "transform": {},
        "globals": {
            "__DEV__": true
        },
        "setupFilesAfterEnv": [
            "<rootDir>/tests/setup.js"
        ],
        "collectCoverageFrom": [
            "src/**/*.js",
            "!src/**/*.test.js",
            "!src/debug/**/*.js"
        ],
        "coverageReporters": [
            "text",
            "html",
            "lcov"
        ],
        "testPathIgnorePatterns": [
            "/node_modules/",
            "/dist/"
        ]
    },
    "devDependencies": {
        "jest": "^30.3.0",
        "jest-environment-jsdom": "^30.3.0",
        "eslint": "^10.0.3",
        "eslint-config-standard": "^17.1.0",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-n": "^17.24.0",
        "eslint-plugin-promise": "^7.2.1",
        "prettier": "^3.8.1",
        "husky": "^9.1.7",
        "lint-staged": "^16.4.0"
    },
    "keywords": [
        "game",
        "javascript",
        "canvas",
        "vampire-survivors",
        "browser-game",
        "performance"
    ],
    "author": "Enhanced by Claude",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/BareTread/vampire-survivors-enhanced.git"
    },
    "lint-staged": {
        "src/**/*.js": [
            "eslint --fix",
            "prettier --write"
        ]
    }
}
